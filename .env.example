# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner .env.
# Les variables lues par Vite côté navigateur doivent commencer par VITE_.

# URL du projet Supabase (utilisée à partir du jalon M2)
VITE_SUPABASE_URL=

# Clé publique "anon" de Supabase. Elle est publique par conception, la sécurité repose sur la RLS.
# Ne JAMAIS mettre ici la clé service_role.
VITE_SUPABASE_ANON_KEY=